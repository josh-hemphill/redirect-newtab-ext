{
	"name": "new-tab-redirect",
	"type": "module",
	"version": "2.1.0",
	"private": true,
	"packageManager": "pnpm@10.19.0",
	"description": "Redirect the browser's new tab to a custom URL",
	"author": {
		"name": "Josh Hemphill",
		"email": "dev@joshhemphill.com"
	},
	"license": "MIT",
	"homepage": "https://github.com/josh-hemphill/newtab-redirect-ext",
	"repository": "https://github.com/josh-hemphill/newtab-redirect-ext",
	"issues": "https://github.com/josh-hemphill/newtab-redirect-ext/issues",
	"keywords": [
		"chrome",
		"extension",
		"new tab",
		"redirect"
	],
	"scripts": {
		"build": "cross-env NODE_ENV=production vite-ssg build && tsx scripts/create-artifact.ts",
		"build:dev": "cross-env NODE_ENV=development vite-ssg build",
		"dev": "vite --port 3333 --open",
		"release": "tsx scripts/release.ts",
		"lint": "eslint .",
		"preview": "vite preview",
		"preview-https": "serve dist",
		"test": "vitest",
		"test:e2e": "cypress open",
		"test:unit": "vitest",
		"typecheck": "vue-tsc --noEmit",
		"sizecheck": "vite-bundle-visualizer"
	},
	"dependencies": {
		"@mdi/js": "catalog:frontend",
		"@unhead/vue": "catalog:frontend",
		"@vueuse/core": "catalog:frontend",
		"nprogress": "catalog:frontend",
		"pinia": "catalog:frontend",
		"vue": "catalog:frontend",
		"vue-concurrency": "catalog:frontend",
		"vue-i18n": "catalog:frontend",
		"vue-router": "catalog:frontend",
		"vuetify": "catalog:frontend"
	},
	"devDependencies": {
		"@antfu/eslint-config": "catalog:dev",
		"@crxjs/vite-plugin": "catalog:build",
		"@intlify/unplugin-vue-i18n": "catalog:build",
		"@types/chrome": "catalog:types",
		"@types/fs-extra": "catalog:types",
		"@types/node": "catalog:types",
		"@vitejs/plugin-vue": "catalog:build",
		"@vue-macros/volar": "catalog:dev",
		"@vue/test-utils": "catalog:dev",
		"beasties": "catalog:build",
		"bumpp": "catalog:dev",
		"changelogithub": "catalog:dev",
		"cross-env": "catalog:dev",
		"cypress": "catalog:dev",
		"cypress-vite": "catalog:dev",
		"eslint": "catalog:dev",
		"eslint-plugin-cypress": "catalog:dev",
		"eslint-plugin-format": "catalog:dev",
		"eslint-plugin-vuejs-accessibility": "catalog:dev",
		"fs-extra": "catalog:dev",
		"globals": "catalog:dev",
		"https-localhost": "catalog:dev",
		"rollup": "catalog:build",
		"sass-embedded": "catalog:build",
		"tsx": "catalog:dev",
		"typescript": "catalog:dev",
		"unplugin-auto-import": "catalog:build",
		"unplugin-fonts": "catalog:build",
		"unplugin-vue-components": "catalog:build",
		"unplugin-vue-macros": "catalog:build",
		"unplugin-vue-markdown": "catalog:build",
		"unplugin-vue-router": "catalog:build",
		"vite": "catalog:build",
		"vite-bundle-visualizer": "catalog:build",
		"vite-plugin-inspect": "catalog:build",
		"vite-plugin-vue-devtools": "catalog:build",
		"vite-plugin-vuetify": "catalog:build",
		"vite-ssg": "catalog:build",
		"vitest": "catalog:dev",
		"vue-macros": "catalog:build",
		"vue-tsc": "catalog:dev",
		"zx": "catalog:dev"
	}
}
